<h1 style="margin:0 0 12px;font-size:20px;">Hi <%= @user.name %>,</h1>

<p style="margin:0 0 16px;line-height:1.6;">
  You have <strong><%= pluralize(@todos.size, "todo") %></strong> due today.
</p>

<ul style="margin:0 0 20px;padding-left:18px;line-height:1.8;">
  <% @todos.each do |todo| %>
    <li>
      <strong><%= todo.title %></strong>
      <span style="color:#71717a;">&middot; <%= todo.priority %></span>
      <% if todo.category %>
        <span style="color:<%= todo.category.color %>;">&middot; <%= todo.category.name %></span>
      <% end %>
    </li>
  <% end %>
</ul>

<p style="margin:0;">
  <a href="<%= frontend_url %>" style="display:inline-block;background:#6366f1;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:8px;">Open your todos</a>
</p>
