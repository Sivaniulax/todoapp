# Copy to your shell / Render environment as needed.
DB_USERNAME=postgres
DB_PORT=5432
DB_PASSWORD=postgres
FRONTEND_ORIGINS=http://localhost:5173
# Session cookie. Leave as "lax" and serve the app and API from one domain:
# "none" is only for a split deployment, and it gives up the CSRF protection
# that Lax provides, so add CSRF tokens before you set it.
SESSION_COOKIE_SAME_SITE=lax
# Optional: seeds an admin user
ADMIN_EMAIL=admin@todoapp.dev
ADMIN_PASSWORD=password123

# Background jobs (Solid Queue). It runs inside Puma by default; set this to
# "false" and run `bin/jobs` if you want a separate worker process.
SOLID_QUEUE_IN_PUMA=true
JOB_CONCURRENCY=1

# Mail. Without MAIL_SMTP_ADDRESS production simply does not deliver, and
# development never delivers at all - read mail at /rails/mailers instead.
MAIL_FROM=TodoApp <no-reply@todoapp.dev>
APP_HOST=localhost
MAIL_SMTP_ADDRESS=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
